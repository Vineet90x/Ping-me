# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
# Service role key — needed for storage uploads (bypasses RLS).
# Supabase dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_INVOICE_BUCKET=invoices

# Redis (Upstash) — optional locally; falls back to in-memory sessions
REDIS_URL=rediss://default:TOKEN@host:port

# Twilio — optional locally; outgoing messages are logged & skipped if unset
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# REST API security — callers of /api/salons/* must send this as X-API-Key.
# If unset, the REST API is UNPROTECTED (a startup warning is logged).
ADMIN_API_KEY=change-me-to-a-long-random-string

# Reject webhook calls without a valid Twilio signature. Keep False for local
# ngrok testing; set True in production.
VERIFY_TWILIO_SIGNATURE=False

# App
DEBUG=True
# Comma-separated allowed CORS origins. Use the dashboard URL in production.
CORS_ORIGINS=*
# Public URL of this API, used to build tappable https payment links.
PUBLIC_BASE_URL=http://localhost:8800
